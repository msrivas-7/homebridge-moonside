{
  "pluginAlias": "MoonsideCloud",
  "pluginType": "platform",
  "singular": true,
  "strictValidation": true,
  "schema": {
    "type": "object",
    "required": [
      "name",
      "email",
      "password"
    ],
    "additionalProperties": false,
    "properties": {
      "name": {
        "title": "Name",
        "type": "string",
        "default": "Moonside Cloud"
      },
      "email": {
        "title": "Moonside Account Email",
        "type": "string",
        "format": "email"
      },
      "password": {
        "title": "Moonside Account Password",
        "type": "string",
        "format": "password",
        "password": true
      },
      "logLevel": {
        "title": "Log Level",
        "type": "string",
        "default": "warning",
        "oneOf": [
          {
            "title": "Debug",
            "const": "debug"
          },
          {
            "title": "Warnings Only",
            "const": "warning"
          },
          {
            "title": "Errors Only",
            "const": "none"
          }
        ],
        "description": "Controls how chatty the plugin logs should be. Debug will also show every realtime update payload."
      },
      "enablePolling": {
        "title": "Enable Polling Fallback",
        "type": "boolean",
        "default": false,
        "description": "Use periodic polling in addition to the realtime stream. Only enable if your network blocks the Firebase streaming API."
      },
      "pollingInterval": {
        "title": "Polling Interval (seconds)",
        "type": "number",
        "minimum": 5,
        "default": 60,
        "description": "How often the accessory should poll the cloud when polling fallback is enabled."
      },
      "themePicker": {
        "title": "Theme Picker and Apple Home Favorites",
        "type": "boolean",
        "default": false,
        "description": "Enable theme browsing in a compatible Homebridge UI. Star configured themes to show them together in an Apple Home Favorites accessory. Existing theme switches remain available for automations."
      },
      "retainLegacyThemeSwitches": {
        "title": "Keep Existing Theme Switches",
        "type": "boolean",
        "description": "With the theme picker enabled, existing theme switches are kept for your automations by default. Turn this off to remove the old full-catalog accessory. New setups expose only favorites."
      },
      "themeSwitches": {
        "title": "Theme Switches",
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Optional list of theme names that should appear as stateless switches on each lamp. The plugin will match the names against the official catalog (e.g., \"Dancing Ocean\")."
      },
      "themeSetup": {
        "title": "Theme Setup",
        "description": "Managed by guided theme setup. Existing manual theme switches remain independent.",
        "type": "object",
        "properties": {
          "version": {
            "type": "integer",
            "const": 1
          },
          "id": {
            "type": "string"
          },
          "mode": {
            "type": "string",
            "enum": [
              "selected",
              "all"
            ]
          },
          "selectedIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 1000
          },
          "lamps": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "object",
              "properties": {
                "deviceId": {
                  "type": "string"
                },
                "ids": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "maxItems": 99
                },
                "expectedRevision": {
                  "type": "integer",
                  "minimum": 0
                },
                "enabled": {
                  "type": "boolean"
                },
                "selectedIds": {
                  "type": "array",
                  "maxItems": 1000,
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "deviceId",
                "ids",
                "expectedRevision"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "version",
          "id",
          "mode",
          "selectedIds",
          "lamps"
        ],
        "additionalProperties": false
      }
    }
  },
  "customUi": true,
  "layout": [
    {
      "key": "name"
    },
    {
      "key": "email"
    },
    {
      "key": "password"
    },
    {
      "key": "logLevel"
    },
    {
      "key": "enablePolling"
    },
    {
      "key": "pollingInterval"
    },
    {
      "key": "themePicker"
    },
    {
      "key": "retainLegacyThemeSwitches"
    },
    {
      "key": "themeSwitches"
    }
  ]
}
